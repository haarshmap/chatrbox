<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://minima.namishh.com/dist/minima.min.css" />
    <script defer src="https://minima.namishh.com/dist/minima.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"
        integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V"
        crossorigin="anonymous"></script>
    <script src="https://unpkg.com/htmx-ext-ws@2.0.0/ws.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/lib/marked.umd.js"></script>
    <title> Testingg </title>
</head>

<body data-username="{{ .Username }}">
    <h1>Room: {{ .RoomName }}</h1>
    <br>
    <p>Currently just slop i suppose</p>
    <br>
    <div id="messageHistory" hx-get="/room/{{ .RoomCode }}/msg" hx-trigger = "load" hx-swap="innerHTML">
    </div>
    <div hx-ext="ws" ws-connect="/ws/{{ .RoomCode }}">
        <div id="log">
        </div>
        <form id="deliveryForm" ws-send style="display:none">
            <input type="hidden" name="type" value="delivered">
            <input type="hidden" name="message_id" id="deliveryMessageID">
        </form>

        <form id="readForm" ws-send style="display:none">
            <input type="hidden" name="type" value="read">
            <input type="hidden" name="message_id" id="readMessageID">
        </form>
        <form id="form" class="form" ws-send>
            <input type="hidden" name="type" value="message">
            <input type="submit" value="Send" class="button-primary">
            <input type="text" name="message" id="msg" size="64" autofocus class="form-input">
            <input type="hidden" name="reply_to_id" id="replyToID" value="">
        </form>

        <div id="replyPreview" hidden>
            <p>Replying to <strong id="replyUsername"></strong></p>
            <p id="replyMessage"></p>
            <button type="button" class="button-primary" id="cancelReply">Cancel reply</button>
        </div>

        <br>
        <br>
        <div id="admin">
            {{ template "isAdmin" . }}
        </div>
        <br>
        <form id="formLeaveRoom" hx-post="/room/{{ .RoomCode }}/leave" hx-trigger="submit">
            <button class="button-primary" id="leave">Leave Room</button>
        </form>
        <br>
</body>

<script>
    const form = document.getElementById("form");
    const input = document.getElementById("msg");
    const log = document.getElementById("log");
    const currentUsername = document.body.dataset.username;

    const deliveryForm = document.getElementById("deliveryForm");
    const deliveryMessageID = document.getElementById("deliveryMessageID");
    const readForm = document.getElementById("readForm");
    const readMessageID = document.getElementById("readMessageID");

    const replyToID = document.getElementById("replyToID");
    const replyPreview = document.getElementById("replyPreview");
    const replyUsername = document.getElementById("replyUsername");
    const replyMessage = document.getElementById("replyMessage");
    const cancelReply = document.getElementById("cancelReply");

    const observedMessages = new Set();
    const readMessages = new Set();

    form.addEventListener("submit", () => {
        setTimeout(() => {
            input.value = "";
            input.focus();

            replyToID.value = "";
            replyPreview.hidden = true;
            replyUsername.textContent = "";
            replyMessage.textContent = "";

        }, 0);
    });

    log.addEventListener("click", event => {
        const button = event.target.closest(".reply-button");

        if (!button) {
            return;
        }

        replyToID.value = button.dataset.messageId;
        replyUsername.textContent = button.dataset.username;
        replyMessage.textContent = button.dataset.message;
        replyPreview.hidden = false;

        input.focus();
    });

    cancelReply.addEventListener("click", () => {
        replyToID.value = "";
        replyPreview.hidden = true;
        replyUsername.textContent = "";
        replyMessage.textContent = "";
    });

    function updateStatus(event) {
        const status = document.getElementById(`status-${event.message_id}`);

        if (!status) {
            return;
        }

        if (event.type === "sent") {
            status.textContent = "Sent";
        } else if (event.type === "delivered") {
            status.textContent = "Delivered";
        } else if (event.type === "read") {
            status.textContent = "Read";
        }
    }

    function sendDelivery(messageID) {
        deliveryMessageID.value = messageID;
        deliveryForm.requestSubmit();
    }

    function sendRead(messageID) {
        if (readMessages.has(messageID)) {
            return;
        }

        readMessages.add(messageID);
        readMessageID.value = messageID;
        readForm.requestSubmit();
    }

    const visibilityObserver = new IntersectionObserver(entries => {
        for (const entry of entries) {
            if (!entry.isIntersecting) {
                continue;
            }

            const message = entry.target;

            if (message.dataset.username !== currentUsername) {
                sendRead(message.id.replace("message-", ""));
            }

            visibilityObserver.unobserve(message);
        }
    });

    function observeMessage(message) {
        if (!message.id.startsWith("message-") || observedMessages.has(message.id)) {
            return;
        }

        observedMessages.add(message.id);

        if (message.dataset.username !== currentUsername) {
            visibilityObserver.observe(message);
        }
    }

    function scanMessages(node) {
        if (node.nodeType !== Node.ELEMENT_NODE) {
            return;
        }

        if (node.matches("p[id^='message-']")) {
            observeMessage(node);
        }

        node.querySelectorAll("p[id^='message-']").forEach(observeMessage);
    }

    const messageObserver = new MutationObserver(records => {
        for (const record of records) {
            record.addedNodes.forEach(scanMessages);
        }
    });

    messageObserver.observe(log, { childList: true, subtree: true });
    log.querySelectorAll("p[id^='message-']").forEach(observeMessage);

    document.body.addEventListener("htmx:wsBeforeMessage", event => {
        const payload = event.detail.message;
        let data;

        try {
            data = JSON.parse(payload);
        } catch {
            const parsed = new DOMParser().parseFromString(payload, "text/html");
            const message = parsed.querySelector("p[id^='message-']");

            if (message && message.dataset.username !== currentUsername) {
                sendDelivery(message.id.replace("message-", ""));
            }

            return;
        }

        if (["sent", "delivered", "read"].includes(data.type)) {
            event.preventDefault();
            updateStatus(data);
        }
    });
</script>


{{ define "message" }}
<div id="log" hx-swap-oob="beforeend">
    <p id="message-{{ .MessageID }}" data-username="{{ .Username }}">
        <strong>{{ .Username }}</strong>:
        <span hx-disable>{{ .Message }}</span>
        <span>{{ .Time_Stamp }}</span>
        <span id="status-{{ .MessageID }}"></span>
        <button type="button" class="reply-button" data-message-id="{{ .MessageID }}" data-username="{{ .Username }}" data-message="{{ .Message }}"> Reply </button>
    </p>
</div>
{{ end }}

{{ define "messageHistory" }}
    {{ range . }}
        <div id="message-{{ .MessageID }}" data-username="{{ .Username }}">

            {{ if .ReplyToID }}
                <div class="reply-context">
                    <small>
                        Replying to <strong>{{ .ReplyUsername }}</strong>:
                        {{ .ReplyMessage }}
                    </small>
                </div>
            {{ end }}

            <strong>{{ .Username }}:</strong>
            <span class="body">{{ .Message }}</span>
            <span class="time">{{ .Time_Stamp }}</span>

            <button
                type="button"
                class="reply-button"
                data-message-id="{{ .MessageID }}"
                data-username="{{ .Username }}"
                data-message="{{ .Message }}">
                Reply
            </button>

        </div>
    {{ end }}
{{ end }}

{{ define "isAdmin" }}
    {{ if .Roles }}
        <h1>Admin</h1>
        <br>
        <form class="form" id="toKick" hx-post="/room/{{ .RoomCode }}/kick" hx-trigger="submit">
            <input class="form-input" id="usernameKick" name="usernameKick" type="text">
            <input type="submit" value="To Kick" class="button-primary">
        </form>
    {{ end }}
{{ end }}
</html>
